# ──────────────────────────────────────────────────────────────────────
#  Discord AI Bot — Configuration (provider-agnostic)
# ──────────────────────────────────────────────────────────────────────
#  Copy this file to .env and edit the values marked EDIT.

# ════════════════════════════════════
#  REQUIRED
# ════════════════════════════════════

# Discord bot token — create at https://discord.com/developers/applications (Bot → Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token-here   # EDIT

# ════════════════════════════════════
#  AI PROVIDER (any OpenAI-compatible API)
# ════════════════════════════════════

# Base URL for the inference provider.
#   Direct Ollama            → http://host.docker.internal:11434/v1
#   Ollama on remote host    → http://<IP>:11434/v1
#   Cloud (e.g. OpenRouter)  → https://openrouter.ai/api/v1
INFER_URL=http://127.0.0.1:11434/v1       # EDIT

# API key — leave empty for local Ollama; set for cloud providers
INFER_API_KEY=                                  # EDIT

# ════════════════════════════════════
#  BOT BEHAVIOUR
# ════════════════════════════════════

# Messages retained per channel (pairs = user+AI turns).
CONTEXT_WINDOW=10                               # optional; increase if your GPU is slow

# Set to "clear" (or 1/true/yes) and restart the bot — wipes all stored chat history.
CHAT_HISTORY_RESET=                              # optional

# Prefix for non-slash commands (e.g. !ai what is ai?)
BOT_PREFIX=!ai                                  # optional

# HTTP timeout in seconds before giving up on a model response
AI_REQUEST_TIMEOUT=120                           # optional; increase if your GPU is slow

# §3.9: optional liveness probe for the AI backend.
# 0 = probe once at startup; positive integer = repeat at that many seconds.
AI_HEALTH_CHECK_INTERVAL=0
AI_HEALTH_CHECK_TIMEOUT=5

# Global max tokens baseline. Per-character override can be set in characters.json.
MAX_TOKENS=2000

# Absolute upper bound applied on top of the per-character/global value.
MAX_TOKENS_HARD_CAP=4096                         # optional; keeps outputs Discord-friendly

# ════════════════════════════════════
#  KNOWLEDGE BASE (filesystem)
# ════════════════════════════════════

# Default KB name to query on startup (folder in KB_PATH).
KB_DEFAULT_KB=humblewood                        # EDIT — lowercase slug

# Where KB source files live (used for /upload_kb and /list_kb_docs).
# Defaults to <repo_root>/data/knowledge if left empty — resolved relative
# to the bot source, so it works no matter what directory you start the bot from.
KB_PATH=                                        # optional; absolute or relative KB dir

# Where characters.json lives. Defaults to <repo_root>/characters.json.
CHARACTERS_FILE=                                # optional; path to your characters.json

# Where chat history + active-character picks are persisted (survives restarts).
# Defaults to <repo_root>/data/chat_history.json. Set to an empty string to
# disable persistence (history lives in RAM only).
HISTORY_PERSIST_FILE=                           # optional

# Where reminders are persisted so they survive bot restarts.
# Defaults to <repo_root>/data/reminders.json. Set to an empty string to
# disable (reminders will not survive a restart).
REMINDERS_PERSIST_FILE=                         # optional

# Chunk size (default tokens per KB chunk) for auto-indexing.
CHUNK_SIZE=2000                                 # optional; change then re-run /reindex_kb

# Max number of KB documents to attach per RAG query.
RAG_MAX_DOCS=4                                  # optional; fewer docs = less truncation risk

# Lines above/below each match anchor for chunk extraction. Wider windows keep complete spell/ability entries together.
RAG_WINDOW_LINES=80                             # optional; increase if you see mid-doc truncation

# Hard cap on RAG context chars sent to the LLM. Docs exceeding this budget are skipped entirely.
RAG_MAX_CHARS=24000                              # optional; reduce to prevent OOM/truncation risk

# Retrieval strategy: "vector" (default, embedding-based) or "keyword" (heuristic fallback).
# Set to "keyword" if you don't have access to an embedding backend.
RAG_RETRIEVAL_METHOD=vector                      # vector | keyword

# Streaming delivery tuning — how fast streamed replies "grow" on screen.
# MIN_FLUSH_CHARS: minimum new characters before the next edit (avoids API spam).
# MAX_FLUSH_INTERVAL: max seconds between edits, so slow streams still feel live.
STREAM_MIN_FLUSH_CHARS=100                       # optional
STREAM_MAX_FLUSH_INTERVAL=1.5                    # optional
