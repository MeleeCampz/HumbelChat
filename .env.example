# ──────────────────────────────────────────────────────────────────────
#  Discord AI Bot — Configuration (provider-agnostic)
# ──────────────────────────────────────────────────────────────────────
#  Copy this file to .env and edit the values marked EDIT.
#  Every variable is read by config/settings.py; lines marked "optional"
#  have working defaults baked in.

# ════════════════════════════════════
#  REQUIRED
# ════════════════════════════════════

# Discord bot token — create at https://discord.com/developers/applications (Bot → Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token-here   # EDIT

# ════════════════════════════════════
#  AI PROVIDER (any OpenAI-compatible API)
# ════════════════════════════════════

# Base URL for the inference provider.
#   Direct Ollama            → http://host.docker.internal:11434/v1
#   Ollama on remote host    → http://<IP>:11434/v1
#   OpenWebUI / unsloth      → http://host.docker.internal:8888/v1
#   Cloud (e.g. OpenRouter)  → https://openrouter.ai/api/v1
INFER_URL=http://127.0.0.1:11434/v1       # EDIT

# API key — leave empty for local Ollama; set for cloud providers.
# Also reused as the API key for the STT http backend (STT_BACKEND=http):
# the transcription request authenticates with this same key.
INFER_API_KEY=                                  # EDIT

# Default model slug sent with every AI request. A per-character model in
# characters.json overrides this; when both are empty the request fails with
# a clear error message.
MODEL_NAME=                                     # EDIT for a working setup

# System prompt fallback, used when the active character has no
# system_prompt of its own. Empty = generic built-in ("You are a helpful
# AI assistant.").
SYSTEM_PROMPT=                                  # optional

# Comma-separated model slugs tried IN ORDER if the primary model fails
# (used by the /summarize & /translate helpers). Empty = no fallback.
FALLBACK_MODELS=                                # optional; e.g. tiny-model,big-model

# Seconds to wait before retrying after falling back to a fallback model.
AI_RETRY_AFTER_FALLBACK_S=30                    # optional; default 30

# ════════════════════════════════════
#  BOT BEHAVIOUR
# ════════════════════════════════════

# Message rounds (user+AI pairs) retained per channel as context for each AI turn.
CONTEXT_WINDOW=10                               # optional

# Set to "clear" (or 1/true/yes) and restart the bot — wipes all stored chat history.
CHAT_HISTORY_RESET=                             # optional

# Prefix for non-slash commands (e.g. !ai what is ai?)
BOT_PREFIX=!ai                                  # optional

# Maximum SILENCE from the AI backend (seconds) before a request fails —
# single knob for all AI calls. For streamed responses it is an idle
# watchdog: any arriving chunk resets it, so an active generation may run
# indefinitely; there is no total wall-clock cap (/ai stop cancels).
# Raise for models with long silent thinking phases (e.g. 300).
AI_TIMEOUT_S=120                                # optional; raise for slow local GPUs/CPUs

# ── Reasoning effort (per task family, #20) ─────────────────────────
# Hybrid-thinking models (e.g. Qwen3.8) spend a hidden reasoning phase before
# answering; at the model default (xhigh) even simple questions pay for
# maximal reasoning. Values: off | low | medium | high | xhigh  ("off" =
# thinking disabled). Unset = current behaviour for that task family.
#
# /ai chat — UNSET keeps today's behaviour (thinking on, model default).
# Benchmarked against Qwen3.8-27B: "low" is consistently ~8 s with no
# measurable quality loss vs high/xhigh (which add 2–5 min of hidden
# thinking on long answers). Recommended: low.
AI_REASONING_EFFORT=                            # optional

# Short mechanical calls: /summarize, /translate, /ocr.
# Effective default is "off" — these gain nothing from the reasoning phase.
# (Note: /translate and /ocr previously ran uncontrolled at the model
# default; this default-off is a deliberate latency fix.)
SUMMARY_REASONING_EFFORT=                       # optional; default off

# /end_session recap (the stored session digest). UNSET keeps the model
# default (max effort) — accuracy of the recap matters more than its
# latency. Set e.g. "low" to make it faster.
RECAP_REASONING_EFFORT=                         # optional; default = model max

# /end_session merged log — long-form narrative merge where quality matters
# more than latency. UNSET keeps today's behaviour (thinking on, model
# default = max effort); set e.g. "high" to trade a little quality for speed.
MERGE_LOG_REASONING_EFFORT=                     # optional

# Hard cap on user message length (chars) before the bot refuses to process it.
MAX_INPUT_CHARS=50000                           # optional

# Per-user AI rate limit: at most N requests per sliding window (seconds).
AI_RATE_LIMIT_MAX=5                             # optional
AI_RATE_LIMIT_WINDOW=60                         # optional

# §3.9: optional liveness probe for the AI backend.
# 0 = probe once at startup; positive integer = repeat at that many seconds.
AI_HEALTH_CHECK_INTERVAL=60
AI_HEALTH_CHECK_TIMEOUT=5

# System prompt used by /end_session to write the AI session recap — a very
# brief digest (max. ~150 words: 6–8 short "What happened" bullets plus
# "Next steps", generated from the session's own documents + notes. It is
# stored with the session and delivered when the NEXT session starts.
# Leave empty to use the built-in default, which is strict on purpose:
#   * it uses ONLY the session's own material (attachments/ + transcripts/
#     documents, then notes) — never other sessions' data;
#   * it instructs the model itself to determine the language of the provided
#     sources and write the entire recap in that language (a German session
#     log yields a German recap) — no hard-coded language detection.
# Set this to fully override how the recap is written (advanced).
SESSION_RECAP_PROMPT=                            # optional

# Output length: requests omit max_tokens by default, so the backend
# (LM Studio) lets the model use its MAXIMUM output length. A per-character
# "max_tokens" in characters.json is still honoured when explicitly set.
# (The old MAX_TOKENS / MAX_TOKENS_HARD_CAP variables are no longer applied.)
#
# Cap for summary calls only (/summarize, /end_session recap): 0 = model
# maximum output length; set a positive number of tokens to cap them.
SUMMARY_CALL_MAX_TOKENS=0                       # optional; 0 = no cap

# ════════════════════════════════════
#  EMBEDDING MODEL
# ════════════════════════════════════

# Embedding model for RAG vector search via the backend's /embeddings endpoint.
# ONLY used when EMBED_BACKEND=remote (legacy). With the recommended
# EMBED_BACKEND=local this is IGNORED — queries use LOCAL_EMBED_MODEL instead.
EMBEDDING_MODEL=                                # optional; remote mode only, e.g. nomic-embed-text:latest

# ── Local (in-process CPU) RAG embeddings + GPU index builds ──────────────
# Embed per-request QUERIES in-process on CPU (no backend model swap). Requires
# the `rag-cpu` extra (sentence-transformers). "remote" = legacy backend /embeddings.
EMBED_BACKEND=local                             # local (recommended) | remote
LOCAL_EMBED_MODEL=BAAI/bge-m3                   # in-process query-embedding model

# Build/rebuild the vector INDEX on the GPU backend instead of CPU (one-time, fast).
# The backend (INFER_URL) must have the SAME model loaded (bge-m3). "local" = build on CPU.
# INDEX_EMBED_MODEL is the EXACT name your backend serves for /embeddings. On an Unsloth
# host that's the GGUF server name (e.g. gpustack/bge-m3-GGUF), which hits the GPU
# llama.cpp path; a bare HF id like BAAI/bge-m3 may instead route to a CPU
# sentence-transformers path and be far slower for a full reindex. Fast GPU reindex:
# unload the chat model (frees VRAM) -> load bge-m3 with batch/ubatch >= 8192 ->
# /reindex_kb -> reload the chat model. Vectors stay interchangeable with the CPU query
# model (same bge-m3), so this never invalidates live retrieval.
INDEX_EMBED_BACKEND=backend                     # backend (GPU, default) | local
INDEX_EMBED_MODEL=BAAI/bge-m3                   # exact name your backend serves; on Unsloth use the GGUF name (e.g. gpustack/bge-m3-GGUF)

# Opt-in relevance floor for RAG attachments (0 = off). Drop dense chunks scoring
# below this cosine similarity before hybrid fusion. Tune from "Vector scores" logs.
RAG_MIN_ATTACH_SCORE=0                          # optional; e.g. 0.35
# Per-chunk relevance gate applied at ATTACH time (after fusion/rerank). A ranked
# chunk whose dense cosine similarity is below this floor is not attached, so only
# genuinely relevant sections reach the prompt. Lexical-only (exact-term) hits are
# always kept. 0 = off. An over-aggressive value can never yield an empty context
# (the retriever falls back to unfiltered selection).
RAG_ATTACH_FLOOR=0.50                           # optional; default 0.50, 0 = off

# Candidate pool sizing (retrieval recall). How many candidate chunks each leg
# pulls before RRF fusion. Larger = better recall for hard lookups (exact names,
# rare terms); the attached context is still bounded by RAG_MAX_DOCS/CHARS/FLOOR.
# Cheap while the reranker is off. Defaults: 48 / 48.
RAG_DENSE_TOP_K=48                              # optional; dense chunks retrieved
RAG_LEXICAL_TOP_K=48                            # optional; BM25 chunks retrieved

# Embedding batch size (docs per /embeddings call) for index builds. Default 8 works
# well for mixed/long content; bigger batches only help short, uniform chunks (the
# backend pads each batch to its longest sequence, so large batches can be slower).
RAG_EMBED_BATCH_SIZE=8                          # optional; tune per your content

# Per-request timeout (seconds) for /embeddings calls. Raise it if the backend is slow
# to cold-load the model, or you see intermittent per-batch CPU fallbacks during builds.
EMBED_TIMEOUT=30                                # optional; default 30

# ── Reranker (cross-encoder) ────────────────────────────────
# Optional second-stage cross-encoder that re-scores the top retrieval candidates for
# tighter ranking. DISABLED by default (deferred): it adds a few seconds per query for
# marginal gains on this knowledge base, so leave off unless you specifically want it.
# Runs in-process on CPU (no separate server). When enabled, RAG_VECTOR_TOP_K is how many
# fused candidates are handed to the reranker.
RERANK_ENABLED=0                                # optional; default off
RERANK_MODEL=BAAI/bge-reranker-v2-m3            # optional
RERANK_TIMEOUT_SECONDS=8                        # optional; default 8
RAG_VECTOR_TOP_K=15                             # optional; candidates passed to the reranker

# ── Session continuity ────────────────────────────────────────
# Attach a short summary of the previous session's context to new /ai prompts so
# multi-session conversations feel continuous. Off = each conversation starts fresh.
LAST_SESSION_CONTEXT_ENABLED=1                  # optional; default on
LAST_SESSION_MAX_CHARS=4000                     # optional; cap on attached prior-session text

# ════════════════════════════════════
#  KNOWLEDGE BASE (filesystem)
# ════════════════════════════════════

# Where KB source files live (used for /upload_kb and /list_kb_docs).
# Defaults to <repo_root>/data/knowledge if left empty — resolved relative
# to the bot source, so it works no matter what directory you start the bot from.
KB_PATH=                                        # optional; absolute or relative KB dir

# Where characters.json lives. Defaults to <repo_root>/characters.json.
CHARACTERS_FILE=                                # optional; path to your characters.json

# Campaign world-info file appended to every AI prompt (setting, party names,
# ongoing hooks). Start from world.md.example. Missing/empty = no world block.
WORLD_CONTEXT_FILE=                             # optional; defaults to <repo_root>/world.md — can also point into your Obsidian vault

# Where chat history + active-character picks are persisted (survives restarts).
# Defaults to <repo_root>/data/chat_history.json. Set to an empty string to
# disable persistence (history lives in RAM only).
HISTORY_PERSIST_FILE=                           # optional

# Where reminders are persisted so they survive bot restarts.
# Defaults to <repo_root>/data/reminders.json. Set to an empty string to
# disable (reminders will not survive a restart).
REMINDERS_PERSIST_FILE=                         # optional

# Where session state (active session, queued next-session reminders) is
# persisted so it survives bot restarts. Defaults to <repo_root>/data/sessions.json.
# Set to an empty string to disable persistence. Session notes themselves are
# written as files under SESSIONS_NOTES_DIR (default <KB_PATH>/session_notes/,
# RAG-enabled) — point it inside an Obsidian campaign vault for two-way sync.
SESSIONS_PERSIST_FILE=                          # optional
SESSIONS_NOTES_DIR=                             # optional; default <KB_PATH>/session_notes/

# ── Obsidian vault sync (#19, docs/obsidian-vault.md) ─────────────────────
# Semicolon-separated name=git_url entries; each vault is cloned into
# <KB_PATH>/<name>/ and pulled + incrementally re-indexed on an interval.
# Empty = feature off. Private repos: embed a fine-grained PAT in the URL,
# e.g. humblewood=https://user:TOKEN@github.com/me/humblewood.git
OBSIDIAN_VAULTS=                                # optional; empty = off
# Name of the two-way vault holding session notes (its token needs Contents
# read+write). Must be one of the names above; empty = all vaults one-way.
OBSIDIAN_CAMPAIGN_VAULT=                        # optional
# Vault pull/commit period in seconds (0 = one startup pass only).
OBSIDIAN_VAULT_PULL_INTERVAL=300                # optional

# Where voice recordings are written by /start_recording & /stop_recording.
# Each recording gets its own subdirectory containing one 16-bit PCM WAV per
# speaker plus a manifest.json with absolute timestamps. Defaults to
# <repo_root>/data/recordings.
RECORDINGS_DIR=                                 # optional; absolute or relative dir

# ────────────────────────────────────────────────────────────────────────
#  SPEECH-TO-TEXT
# ────────────────────────────────────────────────────────────────────────
# After /stop_recording writes the per-speaker WAVs, transcription runs in the
# BACKGROUND (needs STT_ENABLED=1 plus the command's transcribe flag, which
# defaults to on) and the transcript is posted to the channel when done.
# Flags marked "(local only)" / "(http only)" apply to a single backend — the
# other one simply ignores them.

# Transcribe each speaker's WAV automatically after /stop_recording.
# Set to 0 to record only (WAVs + manifest, no transcription).
STT_ENABLED=1

# Which engine transcribes:
#   local — faster-whisper running IN-PROCESS on this machine (default).
#           No upload at all (nothing leaves the box, no size cap). Returns
#           real per-segment timestamps, which enables the interleaved
#           chronological transcript.txt. Model via STT_LOCAL_MODEL.
#   http  — an OpenAI-compatible /v1/audio/transcriptions endpoint (e.g. a
#           Whisper API container). Audio is resampled to 16 kHz, trimmed,
#           and chunked under STT_MAX_UPLOAD_MB before upload; the request
#           asks for verbose_json + segment timestamps, so the interleaved
#           chronological transcript works here too. Addressed by STT_URL
#           (falls back to INFER_URL), auth reuses INFER_API_KEY.
STT_BACKEND=local

# Model name for STT_BACKEND=local: any faster-whisper model id — tiny,
# base, small, medium, large-v3, large-v3-turbo (or an HF repo in owner/model
# form). Downloaded on first use (~1.6 GB for large-v3-turbo). Runs on CPU
# with int8; transcriptions are serialized through one shared model slot.
STT_LOCAL_MODEL=large-v3-turbo

# Model slug as accepted by your backend's /v1/audio/transcriptions route
# (http only — ignored by the local backend). unsloth-studio defaults:
# tiny, base, small, large-v3-turbo, large-v3, qwen3-asr-0.6b,
# qwen3-asr-1.7b — or any HF repo in owner/model form the backend has loaded.
STT_MODEL=qwen3-asr-1.7b

# Base URL of the STT backend (http only).
# Point this at your Whisper/speech container over the network, e.g.
#   http://<stt-host>:8000/v1          (separate container by IP)
# Leave empty to fall back to INFER_URL (single backend serving both chat
# and STT). The request authenticates with INFER_API_KEY.
STT_URL=

# Force a language for transcription (e.g. en, de); empty = auto-detect.
# Applied by both backends.
STT_LANGUAGE=

# HTTP timeout in seconds per upload request (http only — long recordings +
# cold model load). Ignored by the local backend.
STT_TIMEOUT=300

# (local only) Silero VAD filter for faster-whisper: skips silence so long
# quiet recordings don't waste decode time — and stops Whisper from
# hallucinating filler words in the gaps (observed: "Vielen Dank." emitted on
# a stretch where one speaker's track was 100% digital silence).
# Set 0 to transcribe every sample verbatim.
STT_VAD_FILTER=1

# ── http-backend upload handling (trim -> resample -> chunk) ────────────────
# (The local backend ignores all of these — it reads the raw WAV in-process
# and PyAV does the 16 kHz conversion itself.)

# Max bytes per /v1/audio/transcriptions upload. A speaker's audio is split into
# chunks that each fit under this cap, so long recordings still transcribe.
# 0 = unlimited (no size-based splitting). 25 matches most Whisper backends' cap.
STT_MAX_UPLOAD_MB=25

# Also split a speaker's audio into chunks of at most this many seconds, even
# when they'd fit under the size cap (bounds per-request latency on long files).
# 0 = never split by time (size cap only).
STT_CHUNK_SECONDS=600

# Trim leading/trailing silence below STT_SILENCE_DBFS before upload (1/0).
# The recorder writes a full-length WAV with zero-padded edges; trimming removes
# that padding so short meetings don't upload hours of silence. Segment
# timestamps are shifted back onto the shared recording timeline.
STT_TRIM_SILENCE=1

# Silence threshold for trimming, in dBFS (negative). Samples quieter than this
# are treated as silence. -45 is well under typical speech but above the noise floor.
STT_SILENCE_DBFS=-45

# Append the finished transcript to the session that was ACTIVE WHEN THE
# RECORDING STOPPED (transcription runs in the background, so it is pinned to
# that session, not whatever is active when STT finishes). The full transcript
# is stored as timestamped note bullets under <KB_PATH>/session_notes/, so it
# shows up in /session_notes and stays RAG-searchable.
# Set to 0 to keep transcripts out of the session notes.
STT_ADD_TO_SESSION=1

# Display-only estimate used in /list_kb_docs output ("approx N chunks").
# The KB chunker itself uses fixed character-based limits and ignores this value.
CHUNK_SIZE=2000                                 # optional; cosmetic

# Max number of KB documents to attach per RAG query.
RAG_MAX_DOCS=4                                  # optional; fewer docs = less truncation risk

# Max chunks attached per single file (they're joined into one entry). Lower =
# tighter context / less "whole file" bloat; higher = more surrounding sections.
RAG_MAX_CHUNKS_PER_FILE=3                       # optional; default 3

# Lines above/below each match anchor for chunk extraction. Wider windows keep complete spell/ability entries together.
RAG_WINDOW_LINES=80                             # optional; increase if you see mid-doc truncation

# Hard cap on RAG context chars sent to the LLM. Docs exceeding this budget are skipped entirely.
RAG_MAX_CHARS=24000                             # optional; reduce to prevent OOM/truncation risk

# Retrieval strategy: "vector" (default, embedding-based) or "keyword" (heuristic fallback).
# Set to "keyword" if you don't have access to an embedding backend.
RAG_RETRIEVAL_METHOD=vector                     # vector | keyword

# Fuse dense + BM25 (lexical) signals with reciprocal rank fusion. Off = pure vector.
RAG_HYBRID_ENABLED=1                            # optional; default on

# Low-confidence query rewriting (vector path only). When the top similarity
# score of a query is below RAG_REWRITE_MIN_SCORE, the bot asks the LLM for up
# to RAG_QUERY_MAX_EXPANSIONS alternative phrasings and merges the rankings
# (reciprocal rank fusion). Confident queries pay nothing extra.
# Set RAG_QUERY_REWRITER=0 to disable entirely.
RAG_QUERY_REWRITER=1                            # optional; default on
RAG_REWRITE_ALL_QUERIES=1                       # optional; default on — expand EVERY query (off = German/low-confidence only)
RAG_REWRITE_MIN_SCORE=0.35                      # optional; tune from logged "Vector scores" lines
RAG_QUERY_MAX_EXPANSIONS=3                      # optional
RAG_REWRITE_BUDGET_SECONDS=10                   # optional; wall-clock cap for the rewrite call

# Soft cap on total prompt size, in chars (≈ tokens × 4). When exceeded, oldest
# history is trimmed first, then lowest-ranked RAG docs. Tune to the model's real
# context window.
PROMPT_BUDGET_CHARS=100000                      # optional

# ════════════════════════════════════
#  EMBED FORMATTING (structured)
# ════════════════════════════════════

# Render /ai replies as Discord embeds (title + description + inline fields,
# tables become aligned monospace blocks) instead of plain text.
# Set to 0/false/no to disable and restore classic plain-text delivery.
EMBED_FORMAT=1                                  # optional; default on

# ════════════════════════════════════
#  STREAMING AI RESPONSES (P3 #24 / P5)
# ════════════════════════════════════

# Stream /ai responses token-by-token (a "⌨️ Thinking…" placeholder message
# is edited live as the answer grows). Default: on.
# Set to 0 to restore the classic "wait, then deliver the whole reply" path.
AI_STREAM=1                                     # optional; default on
#
# Stream timeouts are governed by AI_TIMEOUT_S (see above): on a stream it
# is an idle watchdog — any arriving chunk resets it. There are no separate
# per-chunk or total budgets.

# ════════════════════════════════════
#  LOGGING (optional overrides)
# ════════════════════════════════════

# Console-only logging, no log files under logs/ (used by the test suite).
#BOT_NO_LOG_FILES=1

# Verbosity of the discord.py logger on the console (and in logs/dev.log).
#BOT_DISCORD_LOG_LEVEL=DEBUG
